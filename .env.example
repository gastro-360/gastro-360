# Copia este fichero a .env y rellénalo. .env nunca se sube al repositorio.
# (O ejecuta ./instalar.sh, que escribe el .env por ti.)
# Cada variable dice: qué hace · valor para probar · valor para producción.
# Todo lo que dejes vacío es válido: la función correspondiente te avisa en pantalla de lo que falta.

# ---------- Restaurante y acceso ----------

# RESTAURANTE: qué carpeta de restaurantes/ sirve esta instalación (sus datos, marca y fotos).
#   Probar: demo (restaurante ficticio de ejemplo) · Producción: el nombre de la carpeta de tu local.
RESTAURANTE=demo

# CLAVE_BACKOFFICE: contraseña para entrar al backoffice. Solo se usa la primera vez,
#   mientras no exista ya una (mínimo 6 caracteres).
#   Probar: cualquiera, p. ej. clave-de-prueba · Producción: una larga y propia; no la repitas en otros sitios.
CLAVE_BACKOFFICE=

# ---------- Dirección y puertos ----------

# DOMINIO: nombre con el que se abre la carta. Con un dominio real, el HTTPS se saca solo.
#   Probar: localhost · Producción: carta.ejemplo.es (tu dominio, ya apuntando a este servidor).
DOMINIO=localhost

# HTTP_PORT y HTTPS_PORT: puertos por los que se entra. Sin permisos de administrador
#   (Docker rootless, pruebas) no se pueden usar los menores de 1024.
#   Probar: 8080 y 8443 · Producción: 80 y 443.
HTTP_PORT=8080
HTTPS_PORT=8443

# URL_PUBLICA: dirección completa y pública de la carta; es la que llevan las tarjetas de Wallet.
#   Probar: vacío (se usa la dirección con la que abres la página) · Producción: https://carta.ejemplo.es
URL_PUBLICA=

# ---------- Pedidos y copias ----------

# COPIA_HORAS: cada cuántas horas se copian los pedidos. 0 = nunca.
#   Probar: 6 · Producción: 6 (o menos si hay mucho movimiento).
COPIA_HORAS=6

# MAX_PEDIDOS_IP: cuántos pedidos puede enviar una misma conexión cada 10 minutos (freno contra abusos).
#   Probar: 10, o un número alto si vas a hacer muchas pruebas seguidas · Producción: 10.
MAX_PEDIDOS_IP=10

# ---------- Correo de promociones (Brevo) ----------
# Sin estas dos variables ni CORREO_MODO=prueba, no hay canal de correo y la pestaña
# Promociones lo explica y desactiva «Enviar».

# BREVO_API_KEY: clave de la API de Brevo (es un secreto: solo aquí, nunca en el repositorio).
#   Probar: vacío · Producción: la clave que da tu cuenta de Brevo.
BREVO_API_KEY=
# BREVO_REMITENTE: correo desde el que salen los envíos; debe estar validado en Brevo.
#   Probar: vacío · Producción: p. ej. hola@ejemplo.es
BREVO_REMITENTE=

# ---------- Aviso de caídas por Telegram (vigilante) ----------
# Si faltan el token o el chat, el vigilante sigue funcionando pero solo escribe en su registro.

# TELEGRAM_BOT_TOKEN: clave del bot que te avisa (secreto: solo aquí).
#   Probar: vacío · Producción: la que te da @BotFather al crear el bot.
TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID: conversación o grupo al que llega el aviso.
#   Probar: vacío · Producción: el número de tu chat con el bot.
TELEGRAM_CHAT_ID=
# TELEGRAM_API_URL: servidor de Telegram. Solo para pruebas con un simulador.
#   Probar: la dirección del simulador · Producción: vacío (se usa el oficial).
TELEGRAM_API_URL=
# VIGILANTE_INTERVALO: cada cuántos segundos comprueba que la carta responde.
#   Probar: 5 (para ver el aviso pronto) · Producción: 30.
VIGILANTE_INTERVALO=30
# VIGILANTE_FALLOS: cuántas comprobaciones seguidas deben fallar antes de avisar de la caída.
#   Probar: 1 · Producción: 3 (evita falsas alarmas).
VIGILANTE_FALLOS=3

# ---------- Modos de prueba ----------
# Con «prueba», los envíos se simulan: no sale nada a Internet. Un restaurante en producción
# los deja vacíos para que nunca se simule nada sin que alguien lo pida aquí.

# CORREO_MODO: «prueba» simula el correo de promociones (el registro dice «Enviado (simulado)»).
#   Probar: prueba · Producción: vacío.
CORREO_MODO=
# WALLET_MODO: «prueba» simula las tarjetas de Apple/Google Wallet con certificados y clientes falsos.
#   Probar: prueba · Producción: vacío (necesita las credenciales reales de Wallet).
WALLET_MODO=

# ---------- Versión e imagen ----------

# GIT_SHA: versión desplegada; la muestra /salud. Lo suele rellenar quien despliega.
#   Probar: vacío · Producción: el identificador del commit desplegado.
GIT_SHA=

# GASTRO_IMAGEN_TAG: etiqueta de la imagen Docker que se construye en local.
#   Probar: local · Producción: local (o una etiqueta propia por versión, para poder volver atrás).
GASTRO_IMAGEN_TAG=local

# No hace falta tocar: PUERTO, ESCUCHAR, CARTA_RESTAURANTES, CARTA_WEB y WALLET_DIR
# los fija la imagen Docker.

# Proxies de confianza (IP, red CIDR o host, separados por comas) de los que se leen X-Forwarded-For y X-Forwarded-Proto. Docker: caddy. Vacío = ninguno.
# PROXY_CONFIABLE=

# Probar: dejar vacío · Producción: 1 solo si hay Cloudflare delante y el proxy solo es accesible por él
# CONFIAR_CF=

# 1: el permiso de publicidad exige confirmarlo por correo (doble confirmación). Vacío: basta con marcar la casilla.
# 1: el permís de publicitat exigeix confirmar-lo per correu (doble confirmació). Buit: només cal marcar la casella.
# Probar: vacío (o 1 para probar la doble confirmación). Producción: vacío.
CONFIRMACION_DOBLE=

# MAX_RESERVAS_IP: cuántas reservas puede enviar una misma conexión cada 10 minutos (freno contra abusos).
# Es un cupo aparte del de los pedidos: reservar no gasta el de pedir ni al revés.
# Probar: 500 (las pruebas automáticas reservan muchas veces seguidas). Producción: 10.
MAX_RESERVAS_IP=10
